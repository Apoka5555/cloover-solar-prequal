# ---------------------------------------------------------------------------
# Single source of configuration for the whole repository.
#
# Copy to .env and adjust. Nothing in the application reads a config file:
# every setting arrives as an environment variable, so the same container
# image runs unchanged in development, staging and production.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Postgres -------------------------------------------------------------
# Used by the database container. Change the password for anything shared.
POSTGRES_USER=cloover
POSTGRES_PASSWORD=cloover_local_password
POSTGRES_DB=cloover
POSTGRES_PORT=5432

# Connection string used by the API and by the Prisma CLI.
# Docker Compose overrides the host with the service name; on the host it is
# localhost. Keep the two in sync if you change the credentials above.
DATABASE_URL=postgresql://cloover:cloover_local_password@localhost:5432/cloover?schema=public

# Separate database used by the integration test suite so a test run never
# destroys your development data.
TEST_DATABASE_URL=postgresql://cloover:cloover_local_password@localhost:5433/cloover_test?schema=public
TEST_POSTGRES_PORT=5433

# --- API ------------------------------------------------------------------
API_PORT=3001
API_GLOBAL_PREFIX=api

# Secret used to sign session tokens. Generate a fresh one per environment:
#   openssl rand -base64 48
JWT_SECRET=change-me-this-is-only-for-local-development-use-openssl-rand
JWT_EXPIRES_IN=1d

# Send the session cookie only over HTTPS. Must be true in any deployed
# environment; false locally because development runs over plain HTTP.
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Browser origins allowed to call the API directly with credentials.
CORS_ORIGINS=http://localhost:3000

# trace | debug | info | warn | error | fatal
LOG_LEVEL=debug
# Pretty-print logs instead of emitting newline-delimited JSON. Development only.
LOG_PRETTY=true

# --- Web ------------------------------------------------------------------
WEB_PORT=3000
# Where the Next.js server proxies /api requests. The browser never sees this.
API_INTERNAL_URL=http://localhost:3001

# --- Seed data ------------------------------------------------------------
# The administrator created by `pnpm db:seed`.
SEED_ADMIN_EMAIL=admin@test.com
SEED_ADMIN_PASSWORD=Admin123!pass
SEED_ADMIN_NAME="Cloover Admin"
SEED_USER_EMAIL=user@test.com
SEED_USER_PASSWORD=User123!pass
SEED_USER_NAME="Sam Homeowner"
