{
  "name": "@cloover/contracts",
  "version": "1.0.0",
  "private": true,
  "description": "Shared API contract: validation schemas, response types and money helpers.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src/",
    "test": "vitest run",
    "test:unit": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "oxlint": "^1.58.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.2"
  }
}
